# Obsidian vault 根目录（绝对路径）
ITMO_VAULT_PATH=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/your-vault

# 主笔记目录（相对 vault 根）
ITMO_INTERVIEW_DIR=06-Interviews

# 观点原子笔记目录（相对 vault 根）
ITMO_VIEWPOINT_DIR=06-Interviews/Viewpoints

# 中间产物目录（相对项目根）
ITMO_DATA_DIR=data

# 字幕语言优先级，逗号分隔，按顺序取第一条命中
# 放宽会触发 YouTube HTTP 429，不要改成 en.*
ITMO_SUB_LANGS=en,en-orig,en-US,en-GB

# 观点归属置信度阈值：低于此值的观点在笔记中标注「归属待确认」
ITMO_ATTRIBUTION_THRESHOLD=0.7
